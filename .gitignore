# Generated SGDK output and local emulator captures
/megadrive/out/
/validation/
__pycache__/
*.pyc

# Large immutable research captures stay on disk. Keep documentation,
# disassembly, reference tables and source for instrumentation reproducibility.
/analysis/*/
!/analysis/**/
/analysis/**/*
!/analysis/**/*.txt
!/analysis/**/*.py
!/analysis/**/manifest.json
!/analysis/*.md
!/analysis/*.json
!/analysis/*.asm
!/analysis/*.txt
!/analysis/*.tbl

# Retain numbered ROMs and their top-level release reports/documentation.
# Source snapshots and bulk captures remain available locally.
/versions/*/**
!/versions/*/
!/versions/*/*.bin
!/versions/*/*.json
!/versions/*/*.md

# Full gameplay movies stay local; version capture recipes,reports and previews.
/videos/**/*.mp4
/videos/**/*.wav

# Generated local video QA; immutable copies live in the evidence archive.
/videos/**/qa-*.jpg
/videos/**/*.log
/videos/**/segments.txt
/videos/**/video-packet-check.txt

# Local lossless compacted validation cache; regenerated outputs stay off Git.
/analysis/local-validation-cache/

# Standalone handoff bundles include binary toolchains; keep archives local.
/handoff/*.zip
