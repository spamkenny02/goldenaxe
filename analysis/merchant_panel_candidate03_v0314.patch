+static void merchant_draw_text(u16 address,const u8 *text)
+{
+    /* Preserve the existing NTSC work interval; PAL misses its publication deadline. */
+    if(!SYS_isPAL()) { save_draw_text(address,text);return; }
+    u16 line=address;
+    while(*text)
+    {
+        u8 value=*text++;
+        if(value==255) { line+=64;address=line;continue; }
+        sms_vram[address++]=merchant_text_tiles[value];sms_vram[address++]=8;
+    }
+}
 
